{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtpbrsurvey.local/schemas/hybrid-reflection-subjective-suite-v1.json",
  "title": "Hybrid Reflection Subjective Validation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "title", "description", "capture", "cases"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": { "$ref": "#/$defs/localizedSuite" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "integer", "boolean"] }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "localizedSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "cases"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "cases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/localizedCase" }
        }
      }
    },
    "localizedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "images", "criteria"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": { "$ref": "#/$defs/localizedImage" },
            "b": { "$ref": "#/$defs/localizedImage" }
          }
        },
        "criteria": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "localizedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "images", "criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["a", "b"],
          "properties": {
            "a": { "$ref": "#/$defs/image" },
            "b": { "$ref": "#/$defs/image" }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    }
  }
}
