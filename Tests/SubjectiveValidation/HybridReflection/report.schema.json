{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtpbrsurvey.local/schemas/hybrid-reflection-subjective-report-v1.json",
  "title": "Hybrid Reflection Subjective Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["reportVersion", "suiteId", "suiteVersion", "capture", "evaluatedAt", "cases"],
  "properties": {
    "reportVersion": { "const": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "integer", "minimum": 1 },
    "locale": { "enum": ["en", "ja"] },
    "capture": { "type": "object" },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criteria", "defects", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "result"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "result": { "enum": ["pass", "fail", "unable", "unanswered"] }
              }
            }
          },
          "defects": {
            "type": "array",
            "items": {
              "enum": ["noise", "silhouette-trail", "internal-trail", "flicker", "screen-edge", "brightness-detail-loss"]
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
